{
  "version": "p2",
  "note": "Voice-aligned lexicon for LinkedIn Content OS. Invisible-character data and the quote normalizer are adapted from vendor/linkedin-agent-skill (MIT, Jake Schincariol). Dashes are reported and kept. A hit is a style flag, not a factual error. See NOTICE.md.",
  "invisible": [
    {
      "cp": "U+200B",
      "name": "ZERO WIDTH SPACE",
      "action": "delete"
    },
    {
      "cp": "U+200C",
      "name": "ZERO WIDTH NON-JOINER",
      "action": "delete"
    },
    {
      "cp": "U+200D",
      "name": "ZERO WIDTH JOINER",
      "action": "delete"
    },
    {
      "cp": "U+2060",
      "name": "WORD JOINER",
      "action": "delete"
    },
    {
      "cp": "U+FEFF",
      "name": "ZERO WIDTH NO-BREAK SPACE / BOM",
      "action": "delete"
    },
    {
      "cp": "U+00AD",
      "name": "SOFT HYPHEN",
      "action": "delete"
    },
    {
      "cp": "U+180E",
      "name": "MONGOLIAN VOWEL SEPARATOR",
      "action": "delete"
    },
    {
      "cp": "U+061C",
      "name": "ARABIC LETTER MARK",
      "action": "delete"
    },
    {
      "cp": "U+200E",
      "name": "LEFT-TO-RIGHT MARK",
      "action": "delete"
    },
    {
      "cp": "U+200F",
      "name": "RIGHT-TO-LEFT MARK",
      "action": "delete"
    },
    {
      "cp": "U+E0000-U+E007F",
      "name": "TAG CHARACTERS (invisible ASCII smuggling)",
      "action": "delete"
    },
    {
      "cp": "U+00A0",
      "name": "NO-BREAK SPACE",
      "action": "space"
    },
    {
      "cp": "U+202F",
      "name": "NARROW NO-BREAK SPACE",
      "action": "space"
    },
    {
      "cp": "U+2009",
      "name": "THIN SPACE",
      "action": "space"
    },
    {
      "cp": "U+2007",
      "name": "FIGURE SPACE",
      "action": "space"
    },
    {
      "cp": "U+2003",
      "name": "EM SPACE",
      "action": "space"
    },
    {
      "cp": "U+2002",
      "name": "EN SPACE",
      "action": "space"
    }
  ],
  "typographic": [
    {
      "from": "—",
      "name": "EM DASH",
      "to": ", ",
      "mode": "report"
    },
    {
      "from": "–",
      "name": "EN DASH",
      "to": "-",
      "mode": "report"
    },
    {
      "from": "‘",
      "name": "LEFT SINGLE QUOTE",
      "to": "'",
      "mode": "rewrite"
    },
    {
      "from": "’",
      "name": "RIGHT SINGLE QUOTE",
      "to": "'",
      "mode": "rewrite"
    },
    {
      "from": "“",
      "name": "LEFT DOUBLE QUOTE",
      "to": "\"",
      "mode": "rewrite"
    },
    {
      "from": "”",
      "name": "RIGHT DOUBLE QUOTE",
      "to": "\"",
      "mode": "rewrite"
    },
    {
      "from": "…",
      "name": "HORIZONTAL ELLIPSIS",
      "to": "...",
      "mode": "report"
    },
    {
      "from": "′",
      "name": "PRIME",
      "to": "'",
      "mode": "report"
    },
    {
      "from": "·",
      "name": "MIDDLE DOT",
      "to": "-",
      "mode": "report"
    },
    {
      "from": "•",
      "name": "BULLET",
      "to": "-",
      "mode": "report"
    },
    {
      "from": "→",
      "name": "RIGHTWARDS ARROW",
      "to": "->",
      "mode": "report"
    }
  ],
  "words": [],
  "phrases": [],
  "structures": [
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|follow me for more)\\s*$",
      "name": "Engagement bait",
      "fix": "Delete it. Voice forbids Thoughts?, Agree?, and follow-me closers."
    },
    {
      "id": "fake-story",
      "regex": "(?i)couldn.t believe what happened next",
      "name": "Fake-story beat",
      "fix": "Delete it. Use the engineering fact instead."
    },
    {
      "id": "n-lessons",
      "regex": "(?i)\\b\\d+\\s+lessons from\\b",
      "name": "Numbered-lessons frame",
      "fix": "Voice rejects this frame. State the one lesson the evidence supports."
    },
    {
      "id": "not-just",
      "regex": "(?i)\\bit.?s not (?:just|only) [^\\n]{2,80}[,.] it.?s\\b",
      "name": "Staged reversal",
      "fix": "Say the one thing you mean. Do not add a claim the registry does not support."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "emoji",
      "regex": "[\\U0001F300-\\U0001FAFF\\u2600-\\u27BF]",
      "name": "Emoji",
      "fix": "Voice uses no emoji by default. Remove it unless the author asked for one."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "A wall is usually noise. Voice sets no platform hashtag rule and no numeric cap."
    }
  ]
}
